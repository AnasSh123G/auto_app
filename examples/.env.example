# Environment variables for autoapp.
# Copy this to your workspace as .env and fill in your credentials.
# Never commit .env to version control.

# LLM API Keys
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get your API key from https://aistudio.google.com/
GOOGLE_API_KEY=

# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Job Source Credentials
# Adzuna job search API keys from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: employer careers discovery (sources.employer_careers). Parallel Search API key from
# https://platform.parallel.ai/ . Without it, only employer sites already saved are scanned.
PARALLEL_API_KEY=

# Email Credentials
# Gmail: Create an app password (requires 2-Step Verification)
# https://myaccount.google.com/apppasswords
AUTOAPP_ALERTS_PASSWORD=

# SMTP password for sending emails (Gmail app password or mail server password)
AUTOAPP_SMTP_PASSWORD=
