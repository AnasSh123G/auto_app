<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ letter.subject }}</title>
<style>
  @page { size: A4; margin: 18mm 20mm 16mm 25mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Liberation Sans", Arial, Helvetica, "DejaVu Sans", sans-serif;
    font-size: 11pt;
    line-height: 1.32;
    color: #000;
    background: #fff;
  }
  .sender { text-align: right; line-height: 1.3; }
  .sender .name { font-weight: bold; }
  .recipient { margin-top: 12mm; min-height: 22mm; line-height: 1.3; }
  .date { text-align: right; margin-top: 4mm; }
  .subject { font-weight: bold; margin-top: 8mm; }
  .salutation { margin-top: 6mm; }
  .body p { margin: 0 0 3.2mm 0; white-space: pre-line; text-align: left; }
  .body { margin-top: 4mm; }
  .closing { margin-top: 4mm; }
  .signature { margin-top: 13mm; }
</style>
</head>
<body>
<div class="sender">
{% for line in sender_lines %}
<div{% if loop.first %} class="name"{% endif %}>{{ line }}</div>
{% endfor %}
</div>
<div class="recipient">
{% for line in recipient_lines %}
<div>{{ line }}</div>
{% endfor %}
</div>
<div class="date">{{ date_line }}</div>
<div class="subject">{{ letter.subject }}</div>
<div class="salutation">{{ letter.salutation }}</div>
<div class="body">
{% for p in paragraphs %}
<p>{{ p }}</p>
{% endfor %}
</div>
<div class="closing">{{ letter.closing }}</div>
<div class="signature">{{ letter.signature }}</div>
</body>
</html>
